# RepoSeed pinned versions.
#
# Every dependency RepoSeed installs into a new project is pinned here to one
# exact, tested version, and every profile reads it from this file. Nothing
# else decides the version a new project gets: the unit tests read their
# expected versions from here, and the snapshots in tests/snapshots/ record
# what this file produced.
#
# To upgrade: change a value, regenerate and review the snapshots, run the
# tests, and commit this file with the snapshots. PY_RUFF, PY_PYTEST and
# PY_PYRIGHT must also match the dev group in RepoSeed's own pyproject.toml
# (then run "uv lock"). docs/versioning.md has the policy and the full steps.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# Lines starting with "#" are comments.

# --- Tools RepoSeed needs on your machine (minimum versions, checked before
# --- anything is written). Node is only checked for the web and game profiles.
UV_MIN=0.5.0
NODE_MIN=22.13.0

# --- Python packages (installed with "uv add name==version")
PY_FASTAPI=0.141.1
PY_UVICORN=0.54.0
PY_PYTHON_DOTENV=1.2.3
PY_PYSIDE6=6.11.2
PY_RUFF=0.16.9
PY_PYTEST=9.1.1
PY_PYTEST_COV=7.1.0
PY_PYRIGHT=1.1.414
PY_PRE_COMMIT=4.6.2

# --- npm packages (written as exact versions into package.json)
NPM_REACT=19.3.0
NPM_REACT_DOM=19.3.0
NPM_TYPES_REACT=19.3.0
NPM_TYPES_REACT_DOM=19.3.0
NPM_ESLINT=10.11.0
NPM_ESLINT_JS=10.0.1
NPM_TYPESCRIPT_ESLINT=8.71.0
NPM_ESLINT_PLUGIN_REACT_HOOKS=7.1.1
NPM_ESLINT_PLUGIN_REACT_REFRESH=0.5.7
NPM_GLOBALS=17.12.0
NPM_TYPESCRIPT=5.9.3
NPM_VITE=8.3.1
NPM_VITEJS_PLUGIN_REACT=6.1.1
NPM_VITEST=5.0.2
NPM_VITEST_COVERAGE_V8=5.0.2
NPM_TAILWINDCSS=4.3.3
NPM_TAILWINDCSS_VITE=4.3.3
NPM_TESTING_LIBRARY_DOM=10.4.2
NPM_TESTING_LIBRARY_REACT=16.3.3
NPM_TESTING_LIBRARY_JEST_DOM=7.0.1
NPM_JSDOM=29.1.1
NPM_PHASER=4.2.1
NPM_PLAYWRIGHT_TEST=1.63.0
